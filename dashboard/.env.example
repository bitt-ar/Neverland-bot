# Discord Bot Configuration
TOKEN=your_discord_bot_token
PREFIX=!

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neverland

# Control Plane IPC Configuration
CONTROL_PLANE_PORT=8800
CONTROL_PLANE_SECRET=change_this_to_a_secure_random_secret
CONTROL_PLANE_URL=http://127.0.0.1:8800

# Dashboard Server Settings
GUILD_ID=your_discord_guild_id
AUTH_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Dashboard Authentication (IMPORTANT) =====
# The /api/internal/* proxy forwards admin operations to the bot's control
# plane. Set DASHBOARD_PASSWORD to require a login before ANY request reaches
# it (a login page appears at /login). Leave empty ONLY for local development.
DASHBOARD_PASSWORD=
# Optional dedicated secret for signing session cookies (falls back to
# CONTROL_PLANE_SECRET when empty).
DASHBOARD_SESSION_SECRET=
