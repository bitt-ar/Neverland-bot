# Discord Bot Configuration
TOKEN=your_discord_bot_token
PREFIX=!

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neverland

# Control Plane IPC Configuration
CONTROL_PLANE_PORT=8800
CONTROL_PLANE_SECRET=change_this_to_a_secure_random_secret
CONTROL_PLANE_URL=http://127.0.0.1:8800

# Dashboard Server Settings
# GUILD_ID is the dev-mode ID field: in development (no login) it pins the
# default guild so its pages open directly. Production ignores it for
# navigation (all bot servers are listed after login).
GUILD_ID=your_discord_guild_id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Dashboard Authentication =====
# Auth is enabled ONLY in production (NODE_ENV=production) with a
# DASHBOARD_PASSWORD set — non-Discord password login at /login. In dev the
# dashboard is open and relies on the GUILD_ID field alone.
DASHBOARD_PASSWORD=
# Optional dedicated secret for signing session/admin cookies (falls back to
# CONTROL_PLANE_SECRET when empty).
DASHBOARD_SESSION_SECRET=
# Bot owner ID (auto-detected in production from Discord API, can be pinned here)
OWNER_DISCORD_ID=
# Comma-separated Discord user IDs that may access the Overview page as bot
# admins. In production the bot application owner is accepted automatically;
# add developer IDs here (especially for dev mode) or for extra admins.
ADMIN_DISCORD_IDS=

