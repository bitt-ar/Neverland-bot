# Discord Bot Configuration
TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neverland

# Control Plane IPC Configuration
CONTROL_PLANE_PORT=8800
CONTROL_PLANE_SECRET=change_this_to_a_secure_random_secret
CONTROL_PLANE_URL=http://127.0.0.1:8800

# Dashboard Server & Host Configuration
PORT=3000
HOSTNAME=0.0.0.0
GUILD_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Dashboard Authentication & Security =====
AUTH_ENABLED=true
# Dedicated secret for signing session cookies (required in production)
DASHBOARD_SESSION_SECRET=change_me_to_a_strong_session_secret

# Bot owner ID (auto-detected in production from Discord API, can be pinned here)
OWNER_DISCORD_ID=
# Comma-separated Discord user IDs that may access the Overview page as bot admins.
ADMIN_DISCORD_IDS=

