# Discord Bot Configuration
# Bot token from Discord Developer Portal
TOKEN=your_bot_token_here
# Application Client ID from Discord Developer Portal
DISCORD_CLIENT_ID=your_discord_client_id
# Application Client Secret from Discord Developer Portal (OAuth2)
DISCORD_CLIENT_SECRET=your_discord_client_secret
# OAuth Redirect URI (default: http://localhost:3000/api/auth/callback/discord)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# MongoDB Configuration
# Local host: mongodb://localhost:27017
# Docker Compose: mongodb://mongo:27017 (or mongodb://neverland:your_password@mongo:27017/?authSource=admin)
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=neverland
MONGO_INITDB_ROOT_USERNAME=neverland
MONGO_INITDB_ROOT_PASSWORD=change_this_to_a_secure_password

# ===== Environment Mode =====
# Options: development, production
# Note: production strictly enforces >=32 char secrets and dedicated RADIO_ENCRYPTION_KEY
ENVIRONMENT=development

# ===== Network Binding & Ports =====
# Web Dashboard Port (default: 3000)
PORT=3000
# Web Dashboard Binding Host (0.0.0.0 listens on all interfaces for public/network deployment)
HOSTNAME=0.0.0.0

# ===== Control Plane (Internal connection between Dashboard and Bot) =====
# Default: 127.0.0.1 for local isolation. Set to 0.0.0.0 ONLY inside container networks like Docker.
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8800
# Shared secret key — must be >=32 random characters (sent in X-Internal-Secret)
CONTROL_PLANE_SECRET=change_me_to_a_long_random_string
# Control Plane URL as seen by dashboard (in Docker: http://bot:8800)
CONTROL_PLANE_URL=http://127.0.0.1:8800

# ===== Dashboard Session Security =====
# Dedicated secret for signing session cookies (required in production, >=32 characters)
DASHBOARD_SESSION_SECRET=change_me_to_a_strong_session_secret
AUTH_ENABLED=true

# ===== Bot Ownership & Admin Access =====
# Bot owner Discord ID (auto-detected in production mode via Discord API)
OWNER_DISCORD_ID=
# Comma-separated list of Admin Discord IDs authorized to view Overview in dev or prod
ADMIN_DISCORD_IDS=

# ===== Deployment URLs =====
# Optional initial guild override (bot dynamically discovers all servers automatically)
GUILD_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
 
# ===== Radio & 24/7 Broadcast Configuration =====
# Number of radio bots to enable (1 to 3: 1=Main Bot only, 2=Main + 1 Aux, 3=Main + 2 Aux)
RADIO_BOTS_COUNT=3
# Maximum number of playlists allowed per server
RADIO_MAX_PLAYLISTS_PER_GUILD=6
# Enforced by Bot Owner: Maximum allowed storage PER PLAYLIST in MB
# Note: Applies to EACH playlist independently (e.g. 6 playlists × 50 MB = 300 MB total potential server storage)
RADIO_MAX_PLAYLIST_STORAGE_MB=50
# Maximum size allowed for a single uploaded audio track in MB
RADIO_MAX_UPLOAD_SIZE_MB=25
# Dedicated Fernet encryption key for auxiliary bot tokens (generate via python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
RADIO_ENCRYPTION_KEY=
