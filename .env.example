# Discord
# Bot token from Discord Developer Portal
TOKEN=your_bot_token_here
# Dummy prefix (all commands are now slash commands)
PREFIX=!

# MongoDB
# MongoDB connection string (Atlas: mongodb+srv://user:pass@cluster.mongodb.net/...)
MONGODB_URI=mongodb://localhost:27017
# Database name (optional, default: neverland)
MONGODB_DB=neverland

# ===== Control Plane (Internal connection between Dashboard and Bot) =====
# Internal API port inside bot process
CONTROL_PLANE_PORT=8800
# Shared secret key — must be long and random (sent in X-Internal-Secret)
CONTROL_PLANE_SECRET=change_me_to_a_long_random_string
# Control Plane URL as seen by dashboard (in Docker: http://bot:8800)
CONTROL_PLANE_URL=http://127.0.0.1:8800

# ===== Bot Ownership & Admin Access =====
# Bot owner Discord ID (auto-detected in production mode via Discord API)
OWNER_DISCORD_ID=
# Comma-separated list of Admin Discord IDs authorized to view Overview in dev or prod
ADMIN_DISCORD_IDS=

# ===== Development =====
# Initial development guild (dev mode only — used in development instead of login)
GUILD_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: Welcome channels and server settings are configured via the web dashboard or Discord commands:
# /setup welcome - /levelroles - /reactionrole
