# Discord
# توكن البوت من Discord Developer Portal
TOKEN=your_bot_token_here
# بادئة شكلية (كل الأوامر الآن slash commands)
PREFIX=!

# MongoDB
# اتصال MongoDB (Atlas: mongodb+srv://user:pass@cluster.mongodb.net/...)
MONGODB_URI=mongodb://localhost:27017
# اسم قاعدة البيانات (اختياري، الافتراضي neverland)
MONGODB_DB=neverland

# ===== Control Plane (الربط الداخلي بين اللوحة والبوت) =====
# منفذ الـ API الداخلي داخل عملية البوت
CONTROL_PLANE_PORT=8800
# مفتاح مشترك — يجب أن يكون عشوائيًا وطويلًا (يُرسل في X-Internal-Secret)
CONTROL_PLANE_SECRET=change_me_to_a_long_random_string
# عنوان الـ Control Plane كما تراه اللوحة (في Docker: http://bot:8800)
CONTROL_PLANE_URL=http://127.0.0.1:8800

# ===== Bot Ownership & Admin Access =====
# آيدي صاحب البوت الفعلي (يُكتشف تلقائيًا في وضع النشر من Discord API)
OWNER_DISCORD_ID=
# قائمة آيديات الآدمن المصرح لهم برؤية Overview في وضع التطوير أو الإنتاج (مفصولة بفاصلة)
ADMIN_DISCORD_IDS=

# ===== Development =====
# سيرفر التطوير الأولي (وضع dev فقط — يعتمد عليه في وضع التطوير بدل تسجيل الدخول)
GUILD_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ملاحظة: قنوات الترحيب وإعدادات كل سيرفر تُضبط من لوحة التحكم أو بأوامر داخل ديسكورد:
# /setup welcome - /levelroles - /reactionrole
